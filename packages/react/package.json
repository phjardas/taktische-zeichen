{
  "name": "taktische-zeichen-react",
  "version": "0.10.0",
  "description": "Bibliothek für die Erzeugung von taktischen Zeichen nach der DV 102 in JavaScript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phjardas/taktische-zeichen.git"
  },
  "keywords": [
    "svg",
    "dv102",
    "feuerwehr",
    "katastrophenschutz"
  ],
  "author": "Philipp Jardas <philipp@jardas.de>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/phjardas/taktische-zeichen/issues"
  },
  "homepage": "https://github.com/phjardas/taktische-zeichen#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": ["dist"],
  "publishConfig": {
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "shx rm -rf dist icon*.svg playwright-report test-results",
    "build": "tsc",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test:e2e": "playwright test -c playwright-ct.config.ts"
  },
  "dependencies": {
    "taktische-zeichen-core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">= 17.0.0"
  },
  "devDependencies": {
    "@playwright/experimental-ct-react": "1.62.1",
    "@playwright/test": "1.62.1",
    "@types/react": "^19.3.0",
    "prettier": "catalog:",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shx": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.1.0"
  }
}
