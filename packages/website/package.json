{
  "name": "taktische-zeichen-website",
  "private": true,
  "version": "0.9.0",
  "scripts": {
    "clean": "shx rm -rf dist",
    "compile": "webpack",
    "generate": "node scripts/generate.js",
    "build": "pnpm run generate && NODE_ENV=production pnpm run compile && eleventy",
    "start": "pnpm run generate && pnpm run compile && eleventy --serve",
    "format": "prettier --write views src scripts *.js",
    "format:check": "prettier --check views src scripts *.js"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@taktische-zeichen/core": "workspace:^",
    "@taktische-zeichen/react": "workspace:^"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@babel/preset-env": "^8.0.5",
    "@babel/preset-react": "^8.0.1",
    "babel-loader": "^10.1.1",
    "prettier": "catalog:",
    "shx": "catalog:",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3"
  }
}
