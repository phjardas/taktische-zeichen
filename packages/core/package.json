{
  "name": "taktische-zeichen-core",
  "version": "0.11.0",
  "description": "Bibliothek für die Erzeugung von taktischen Zeichen nach der DV 102 in JavaScript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phjardas/taktische-zeichen.git"
  },
  "keywords": [
    "svg",
    "dv102",
    "feuerwehr",
    "katastrophenschutz"
  ],
  "author": "Philipp Jardas <philipp@jardas.de>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/phjardas/taktische-zeichen/issues"
  },
  "homepage": "https://github.com/phjardas/taktische-zeichen#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": ["dist"],
  "publishConfig": {
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:types": "vitest run --typecheck",
    "test:e2e": "tsx e2e/run.ts",
    "test:e2e:update": "tsx e2e/run.ts --update",
    "clean": "shx rm -rf coverage dist test-icons",
    "build": "tsc",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "statistics": "tsx scripts/statistics.ts"
  },
  "dependencies": {
    "base64-js": "^1.5.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "^5.0.0",
    "jest-diff": "^30.5.1",
    "prettier": "catalog:",
    "shx": "catalog:",
    "tsx": "^4.23.13",
    "typescript": "catalog:",
    "vitest": "^5.0.0"
  }
}
