{
  "name": "taktische-zeichen-core",
  "version": "0.10.0",
  "description": "Bibliothek für die Erzeugung von taktischen Zeichen nach der DV 102 in JavaScript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phjardas/taktische-zeichen.git"
  },
  "keywords": [
    "svg",
    "dv102",
    "feuerwehr",
    "katastrophenschutz"
  ],
  "author": "Philipp Jardas <philipp@jardas.de>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/phjardas/taktische-zeichen/issues"
  },
  "homepage": "https://github.com/phjardas/taktische-zeichen#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:e2e": "tsx e2e/run.ts",
    "test:e2e:update": "tsx e2e/run.ts --update",
    "clean": "shx rm -rf coverage dist test-icons",
    "build": "tsc",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "statistics": "tsx scripts/statistics.ts"
  },
  "dependencies": {
    "base64-js": "^1.5.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.1",
    "jest": "^30.5.1",
    "jest-diff": "^30.5.1",
    "prettier": "^3.9.6",
    "shx": "^0.4.0",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
